# ==============================================================================
# DigAlert — Global Environment Variables Example
# ==============================================================================
# Copy this file to '.env' at the root or within specific folders (backend/frontend)
# and configure values as appropriate.

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Use sqlite:///./digalert.db for SQLite, or a postgresql:// connection string
DATABASE_URL=sqlite:///./digalert.db

# JWT Hashing Configuration
JWT_SECRET=your-jwt-signing-secret-key-change-me-in-production
JWT_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Optional: SMTP / Mailer Setup (For email alerts on clashes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@digalert.gov.in
SMTP_PASSWORD=secure-app-specific-password

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
# Base API URL matching backend port
VITE_API_URL=http://localhost:8000
