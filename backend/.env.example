# Example backend environment variables for DigAlert
# Copy to .env and replace values for production

# Primary database URL. For Render (Postgres) use the following format:
# postgres provider URLs sometimes come in the form 'postgres://...';
# SQLAlchemy expects 'postgresql://'. If your host provides 'postgres://',
# set the URL as-is and the application will normalize it automatically.
# Example (local Postgres):
# DATABASE_URL=postgresql://digalert_user:supersecret@db.example.com:5432/digalert
# Example (Render-managed DB):
# DATABASE_URL=postgres://username:password@hostname:5432/dbname

DATABASE_URL=sqlite:///./digalert.db

# JWT settings
JWT_SECRET=changeme-in-production
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=http://localhost:5173

# Optional SMTP settings for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
